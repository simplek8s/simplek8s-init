# Automatically generated by simplek8s-init
[Unit]
Before=initrd-root-fs.target
# sysroot.mount and sysroot-var.mount is already mounted
After=sysroot-etc.mount
After=sysroot-home.mount
After=sysroot-mnt.mount
After=sysroot-opt.mount
After=sysroot-root.mount
After=sysroot-usr-libexec.mount
After=sysroot-usr-local.mount
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/lib/systemd/system-generators/simplek8s-init populate /sysroot
ExecStart=/usr/lib/systemd/system-generators/simplek8s-init configurator /sysroot
#ExecStartPost=/usr/bin/mount -o remount,ro /sysroot
