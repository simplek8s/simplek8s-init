# Automatically generated by simplek8s-firstboot
[Unit]
Before=initrd-root-fs.target
# sysroot.mount and sysroot-var.mount is already mounted
After=sysroot-etc.mount
After=sysroot-home.mount
After=sysroot-mnt.mount
After=sysroot-opt.mount
After=sysroot-root.mount
After=sysroot-usr-libexec.mount
After=sysroot-usr-local.mount
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/env sh -ec '\
    ln -sf usr/bin /sysroot/bin;\
    ln -sf usr/lib /sysroot/lib;\
    ln -sf lib /sysroot/lib64;\
    ln -sf usr/sbin /sysroot/sbin;\
    mkdir -p /sysroot/usr;\
    tar -C /usr/ -cf - . | tar -C /sysroot/usr/ -xf -;\
    cp -pan /etc/ssl /sysroot/etc/;\
    cp -pan /sysroot/usr/share/factory/* /sysroot/'
